{
	"compilerOptions": {
		"target": "es2016",
		"module": "commonjs",
		"outDir": "./dist/",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"incremental": true,
		"skipLibCheck": true
	},
	"include": ["app/ts/*.ts"],
	"exclude": ["node_modules", "dist"]
}
